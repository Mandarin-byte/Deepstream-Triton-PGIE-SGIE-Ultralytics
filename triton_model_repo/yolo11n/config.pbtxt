# PGIE: YOLO11n detector (DeepStream-Yolo export), TensorRT FP16 plan
name: "yolo11n"
platform: "tensorrt_plan"
max_batch_size: 4
default_model_filename: "model.plan"
input [
  { name: "input", data_type: TYPE_FP32, dims: [ 3, 640, 640 ] }
]
output [
  # [anchors, 6] = x1, y1, x2, y2, score, class  (decoded by NvDsInferParseYolo)
  { name: "output", data_type: TYPE_FP32, dims: [ 8400, 6 ] }
]
instance_group [ { count: 1, kind: KIND_GPU, gpus: [ 0 ] } ]
dynamic_batching {
  preferred_batch_size: [ 4 ]
  max_queue_delay_microseconds: 2000
}
version_policy: { latest: { num_versions: 1 } }
